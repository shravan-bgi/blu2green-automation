# Copy to .env and fill in real values. .env is gitignored.

# Application under test
DEMO_BASE_URL=https://demo.blu2green.earth

# Database used for test-side assertions and data lookups. Read-only queries can
# also go through the b2g-mysql MCP server; this user additionally holds UPDATE,
# so confine writes to fixture accounts.
DEMO_DB_HOST=your-instance.ap-south-1.rds.amazonaws.com
DEMO_DB_PORT=3306
DEMO_DB_NAME=bgi_b2g_reg_dev
DEMO_DB_USER=
DEMO_DB_PASSWORD=

# Fixture-account values are NOT here. Email, mobile and password are test data
# on a shared demo environment — the password is the static one every test
# account carries — so they live in data/auth.json and are read through
# @config/auth-cases. Only things that genuinely differ per environment belong
# in this file.
#
# When new fixture accounts are needed, prefer test-owned ones: an `e2e-` email
# prefix so they are distinguishable from real registrations, and a domain with
# no real MX (`@test.local`), because an address that accepts mail makes any
# flow that sends one an order of magnitude slower.
